# Copy to server/.env and fill in values. server/.env is gitignored.

# Required
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Required — use ONE of these (not both)
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}

# Optional
PORT=3001
NODE_ENV=development

# Optional — comma-separated email domains (no @). Unset in dev if using personal Gmail.
# ALLOWED_AUTH_EMAIL_DOMAINS=tenacare.org
